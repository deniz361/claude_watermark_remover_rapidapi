# Copy to .env and fill in real values. Never commit .env.
RAPIDAPI_PROXY_SECRET=
OPENAI_API_KEY=

# Optional Thorough-mode tuning (same names as the Flask app).
OPENAI_REWRITE_MODEL=gpt-5.6-luna
OPENAI_REWRITE_MAX_CHARACTERS=20000
OPENAI_REWRITE_MAX_OUTPUT_TOKENS=12000
OPENAI_REWRITE_TIMEOUT_SECONDS=25

# Optional RapidAPI controls.
# RAPIDAPI_THOROUGH_TIERS=PRO,ULTRA,MEGA,CUSTOM
# RAPIDAPI_MAX_CHARACTERS=200000
# RAPIDAPI_RATE_LIMIT=60
# RAPIDAPI_RATE_WINDOW_SECONDS=60
