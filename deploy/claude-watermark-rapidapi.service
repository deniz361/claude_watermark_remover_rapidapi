[Unit]
Description=Claude Watermark Remover RapidAPI service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/claude_watermark_rapidapi
EnvironmentFile=/root/claude_watermark_rapidapi/.env
Environment="PATH=/root/miniconda3/envs/claude_watermark_rapidapi/bin"
ExecStart=/root/miniconda3/envs/claude_watermark_rapidapi/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
